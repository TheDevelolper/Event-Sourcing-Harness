<?xml version="1.0" encoding="utf-8"?>
<configuration>
  
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="github" value="https://nuget.pkg.github.com/TheDevelolper/index.json" />
  </packageSources>
  <packageSourceCredentials>
    <github>
      <add key="Username" value="TheDevelolper" />
      <!-- Add this PAT into your ~./zshrc file -->
      <add key="ClearTextPassword" value="%GITHUB_NUGET_PAT%" />
      
    </github>
  </packageSourceCredentials>
  
<!--  <packageSourceMapping>-->
<!--    <packageSource key="https://api.nuget.org/v3/index.json">-->
<!--      <package pattern="*" />-->
<!--    </packageSource>-->
<!--  </packageSourceMapping>-->

</configuration>