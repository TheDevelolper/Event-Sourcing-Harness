{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "System": "Information",
      "Microsoft": "Information"
    }
  },
  "RabbitMQ": {
    "Host": "rabbitmq",
    "Port": 5672
  },
  "Modules": {
    "BankAccountModule": {
      "GetBalanceDisabled": false
    },
    "Authentication": {
      "ClientSecretEnvironmentVar": "AUTH_CLIENT_SECRET"
    }
  }
}